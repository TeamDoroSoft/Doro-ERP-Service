LOGGING_LEVEL_ROOT=INFO

STORE_ACCESS_PORT=8081
STORE_ACCESS_DB_URL=jdbc:postgresql://localhost:5432/store_access_db
STORE_ACCESS_DB_USERNAME=
STORE_ACCESS_DB_PASSWORD=
STORE_ACCESS_REDIS_HOST=localhost
STORE_ACCESS_REDIS_PORT=6379
STORE_ACCESS_REDIS_USERNAME=
STORE_ACCESS_REDIS_PASSWORD=
STORE_ACCESS_REDIS_SSL_ENABLED=false
STORE_ACCESS_SESSION_TIMEOUT=30m
STORE_ACCESS_SESSION_NAMESPACE=doro:store-access:session

COMMERCE_PORT=8082
COMMERCE_DB_URL=jdbc:postgresql://localhost:5432/commerce_db
COMMERCE_DB_USERNAME=
COMMERCE_DB_PASSWORD=
COMMERCE_ACTOR_CONTEXT_SIGNATURE_REQUIRED=true
# Edge 또는 Store Access와 공유하는 Actor Context HMAC Secret. 값이 채워진 파일은 커밋하지 않는다.
COMMERCE_ACTOR_CONTEXT_SECRET=
COMMERCE_ACTOR_CONTEXT_MAX_AGE=PT5M

PAYMENT_PORT=8083
PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/payment_db
PAYMENT_DB_USERNAME=
PAYMENT_DB_PASSWORD=

QUEUE_PORT=8084
QUEUE_DB_URL=jdbc:postgresql://localhost:5432/queue_db
QUEUE_DB_USERNAME=
QUEUE_DB_PASSWORD=

AUDIT_PORT=8085
AUDIT_MONGODB_URI=mongodb://localhost:27017/audit
